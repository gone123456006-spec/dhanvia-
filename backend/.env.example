# development | production (npm start sets production automatically)
# NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=dhanvia
MONGODB_DB_NAME=dhanvia
# MONGODB_MAX_POOL_SIZE=20

# Optional: DNS servers Node uses to resolve mongodb+srv:// (set this if you see "querySrv EBADRESP")
# DNS_SERVERS=8.8.8.8,1.1.1.1

PORT=3001
# HOST=0.0.0.0

# Comma-separated list of allowed frontend origins (only needed when the site is on a different domain than the API)
CORS_ORIGIN=http://localhost:5173,https://www.dhanvia.com,https://dhanvia.com,https://dhanvia-frontend.vercel.app

# Number of reverse proxies in front of the app (Nginx, load balancer). Used for client IPs and rate limiting.
# TRUST_PROXY=1

# Timezone used for "today", reminders and reports
APP_TIMEZONE=Asia/Kolkata

# Admin login session length in days
SESSION_TTL_DAYS=7

# Session cookie only over HTTPS. Defaults to true in production, false in development.
# COOKIE_SECURE=true

# How often the reminder engine checks for due/overdue work
REMINDER_INTERVAL_MINUTES=5

# Set to false on extra instances when running more than one server, so only one runs the reminder jobs
# RUN_JOBS=true

# Vercel only: secret Vercel Cron sends to GET /api/cron/reminders (generate with: openssl rand -hex 32).
# The route is disabled when unset. On Vercel the in-process scheduler does not run; the cron replaces it.
# CRON_SECRET=

# Keep-alive: pings the public health URL so Render's free plan does not idle the service.
# On Render it targets $RENDER_EXTERNAL_URL/api/health automatically; elsewhere it stays off unless KEEP_ALIVE_URL is set.
# KEEP_ALIVE=true
# KEEP_ALIVE_URL=https://dhanvia-webapi.onrender.com/api/health
# KEEP_ALIVE_INTERVAL_SECONDS=30

# Serve the built website + admin panel from this server. Defaults to true in production.
# SERVE_FRONTEND=true
# FRONTEND_DIST=../frontend/dist

# debug | info | warn | error (defaults: info in production, debug in development)
# LOG_LEVEL=info

# Maximum time to finish in-flight requests on shutdown before force-exiting
# SHUTDOWN_TIMEOUT_MS=15000
